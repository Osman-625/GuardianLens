# GuardianLens monorepo: source code + technical docs only.
# Datasets, images, model/run outputs, databases, secrets and environments stay local.

# ---------------------------------------------------------------- secrets
.env
.env.*
!.env.example
**/local_token.txt
**/ai_provider_override.txt
*.pem
*.key

# ------------------------------------------------- environments / caches
.venv/
venv/
node_modules/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
htmlcov/
.next/
frontend/out/
*.tsbuildinfo
.tmp/
.qodo/
.agents/
.codex/
.cursor/
.vscode/
.idea/
.claude/scheduled_tasks.lock
.claude/settings.local.json
condaenv.*.requirements.txt

# ----------------------------------------------------------- OS / office
.DS_Store
Thumbs.db
desktop.ini
~$*

# ------------------------------------------------- databases / logs
*.sqlite
*.sqlite3
*.sqlite3-*
*.db
*.db-*
*.log
*.out

# -------------------------------------- datasets, images, models, archives
GuardianLens_Approved_Dataset/
*.jpg
*.jpeg
*.webp
*.zip
*.npz
*.pt
*.pth
*.ckpt
*.safetensors
*.pkl
