{
  "manifest_version": 3,
  "name": "GuardianLens Data Collection",
  "version": "1.0.0",
  "description": "Capture listings manually or monitor a two-stage queued URL capture and preprocessing replay from the local GuardianLens dashboard.",
  "permissions": ["activeTab", "alarms", "scripting", "storage", "tabs"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://carousell.com.my/*",
    "https://www.carousell.com.my/*",
    "https://mudah.my/*",
    "https://www.mudah.my/*"
  ],
  "optional_host_permissions": ["<all_urls>"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "GuardianLens Capture"}
}
